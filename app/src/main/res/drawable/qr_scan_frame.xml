<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft glow backing -->
    <item android:width="280dp" android:height="280dp">
        <shape android:shape="rectangle">
            <solid android:color="#1400FFAA" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- Top-Left Corner -->
    <item android:width="44dp" android:height="44dp" android:gravity="top|left">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="4dp" android:color="#22C55E" />
            <corners android:topLeftRadius="18dp" />
        </shape>
    </item>

    <!-- Top-Right Corner -->
    <item android:width="44dp" android:height="44dp" android:gravity="top|right">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="4dp" android:color="#22C55E" />
            <corners android:topRightRadius="18dp" />
        </shape>
    </item>
    
    <!-- Bottom-Left Corner -->
    <item android:width="44dp" android:height="44dp" android:gravity="bottom|left">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="4dp" android:color="#22C55E" />
            <corners android:bottomLeftRadius="18dp" />
        </shape>
    </item>
    
    <!-- Bottom-Right Corner -->
    <item android:width="44dp" android:height="44dp" android:gravity="bottom|right">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="4dp" android:color="#22C55E" />
            <corners android:bottomRightRadius="18dp" />
        </shape>
    </item>
</layer-list>
