<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@color/profile_card_border" />

    <TextView
        android:id="@+id/languageSheetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/profile_language"
        android:textColor="@color/profile_text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/languageSheetSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/profile_language_subtitle"
        android:textColor="@color/profile_text_secondary"
        android:textSize="13sp" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/langOptionEn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="@color/profile_card_bg"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/profile_card_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:id="@+id/langLabelEn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/language_english"
                android:textColor="@color/profile_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/langCheckEn"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/selected"
                android:src="@drawable/ic_check"
                android:visibility="invisible"
                app:tint="@color/profile_icon_blue" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/langOptionTh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="@color/profile_card_bg"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/profile_card_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:id="@+id/langLabelTh"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/language_thai"
                android:textColor="@color/profile_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/langCheckTh"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/selected"
                android:src="@drawable/ic_check"
                android:visibility="invisible"
                app:tint="@color/profile_icon_blue" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
