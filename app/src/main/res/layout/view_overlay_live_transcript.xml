<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:minHeight="140dp"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/overlay_transcript_bubble"
    android:elevation="10dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/headerRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvOverlayTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Guardian listening"
                android:textColor="@color/splash_title"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvOverlayRisk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="LISTENING"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@drawable/overlay_badge_bg" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnOverlayClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:background="@android:color/transparent"
            android:padding="4dp"
            android:contentDescription="@string/action_close"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="@color/home_muted" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxHeight="260dp"
        android:fillViewport="true">

        <TextView
            android:id="@+id/tvOverlayTranscript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="..."
            android:textColor="@color/splash_title"
            android:textSize="15sp"
            android:lineSpacingExtra="2dp"
            android:scrollbars="vertical" />
    </ScrollView>
</LinearLayout>
