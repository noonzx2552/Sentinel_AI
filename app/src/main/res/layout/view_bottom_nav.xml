<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <FrameLayout
        android:id="@+id/bottomNavRoot"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="10dp"
        android:paddingTop="3dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/bottomNavContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="0dp"
            app:cardBackgroundColor="@color/bottom_nav_bg"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardUseCompatPadding="false"
            app:strokeColor="@color/bottom_nav_shell_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:id="@+id/bottomNavTabs"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingTop="4dp"
                android:paddingEnd="6dp"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:id="@+id/tabHome"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="1dp"
                    android:paddingEnd="1dp">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center_horizontal">

                        <View
                            android:id="@+id/tabHomeActiveBg"
                            android:layout_width="28dp"
                            android:layout_height="3dp"
                            android:layout_gravity="top|center_horizontal"
                            android:background="@drawable/bottom_nav_tab_active_bg"
                            android:visibility="invisible" />

                        <ImageView
                            android:id="@+id/tabHomeIcon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/home_nav_home"
                            android:src="@drawable/ic_nav_home"
                            app:tint="@color/bottom_nav_inactive" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tabHomeLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/home_nav_home"
                        android:textColor="@color/bottom_nav_inactive"
                        android:textSize="11sp"
                        android:textStyle="normal" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabActivity"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="1dp"
                    android:paddingEnd="1dp">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center_horizontal">

                        <View
                            android:id="@+id/tabActivityActiveBg"
                            android:layout_width="28dp"
                            android:layout_height="3dp"
                            android:layout_gravity="top|center_horizontal"
                            android:background="@drawable/bottom_nav_tab_active_bg"
                            android:visibility="invisible" />

                        <ImageView
                            android:id="@+id/tabActivityIcon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/home_nav_activity"
                            android:src="@drawable/ic_nav_activity"
                            app:tint="@color/bottom_nav_inactive" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tabActivityLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/home_nav_activity"
                        android:textColor="@color/bottom_nav_inactive"
                        android:textSize="11sp"
                        android:textStyle="normal" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabScan"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="1dp"
                    android:paddingEnd="1dp">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center_horizontal">

                        <View
                            android:id="@+id/tabScanActiveBg"
                            android:layout_width="28dp"
                            android:layout_height="3dp"
                            android:layout_gravity="top|center_horizontal"
                            android:background="@drawable/bottom_nav_tab_active_bg"
                            android:visibility="invisible" />

                        <ImageView
                            android:id="@+id/tabScanIcon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/home_nav_scan"
                            android:src="@drawable/ic_nav_scan"
                            app:tint="@color/bottom_nav_inactive" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tabScanLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/home_nav_scan"
                        android:textColor="@color/bottom_nav_inactive"
                        android:textSize="11sp"
                        android:textStyle="normal" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabProfile"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="1dp"
                    android:paddingEnd="1dp">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center_horizontal">

                        <View
                            android:id="@+id/tabProfileActiveBg"
                            android:layout_width="28dp"
                            android:layout_height="3dp"
                            android:layout_gravity="top|center_horizontal"
                            android:background="@drawable/bottom_nav_tab_active_bg"
                            android:visibility="invisible" />

                        <ImageView
                            android:id="@+id/tabProfileIcon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/home_nav_profile"
                            android:src="@drawable/ic_nav_profile"
                            app:tint="@color/bottom_nav_inactive" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tabProfileLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/home_nav_profile"
                        android:textColor="@color/bottom_nav_inactive"
                        android:textSize="11sp"
                        android:textStyle="normal" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>
</merge>
