<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/card_margin_top"
    app:cardBackgroundColor="@color/home_card_bg"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:cardUseCompatPadding="false"
    app:strokeColor="@color/home_card_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <FrameLayout
            android:id="@+id/recentIconBadge"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/home_badge_red_bg">

            <ImageView
                android:id="@+id/recentIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/intro_icon_shield"
                android:tint="@color/home_accent_red" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/recentTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/checknumber_recent_item1_title"
                android:textColor="@color/splash_title"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/recentBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/checknumber_recent_item1_body"
                android:textColor="@color/home_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/recentTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/checknumber_tag_unsafe_bg"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="@string/checknumber_recent_item1_tag"
            android:textColor="@color/home_accent_red"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
